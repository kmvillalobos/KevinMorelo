---
import { site } from '@data/site';
import { Icon } from 'astro-icon/components';
---

<div class="flex flex-wrap items-center justify-center gap-2">
  <a
    href={site.contact.github}
    class="subtle-link inline-flex h-9 w-9 items-center justify-center rounded"
    target="_blank"
    rel="noreferrer"
    aria-label="GitHub"
  >
    <Icon name="ph:github-logo" class="h-6 w-6" />
  </a>
  <a
    href={site.contact.linkedin}
    class="subtle-link inline-flex h-9 w-9 items-center justify-center rounded"
    target="_blank"
    rel="noreferrer"
    aria-label="LinkedIn"
  >
    <Icon name="ph:linkedin-logo" class="h-6 w-6" />
  </a>
  <a
    href={`mailto:${site.contact.email}`}
    class="subtle-link inline-flex h-9 w-9 items-center justify-center rounded"
    aria-label="Email"
  >
    <Icon name="ph:envelope-simple" class="h-6 w-6" />
  </a>
  <a
    href={site.contact.project}
    class="subtle-link inline-flex h-9 w-9 items-center justify-center rounded"
    target="_blank"
    rel="noreferrer"
    aria-label="Proyecto Sociedad Biomédica"
  >
    <Icon name="ph:globe" class="h-6 w-6" />
  </a>
  <a
    href={site.contact.cv}
    class="subtle-link inline-flex items-center gap-2 rounded border border-accent/30 px-3 py-2 text-xs font-semibold uppercase tracking-[0.18em] hover:border-accent"
    target="_blank"
    rel="noreferrer"
    aria-label="Descargar CV"
  >
    <Icon name="ph:file-pdf" class="h-4 w-4" />
    CV
  </a>
</div>
